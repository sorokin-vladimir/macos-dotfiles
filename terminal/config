# KEYBINDS
keybind = global:cmd+g=toggle_quick_terminal

# Navigate between splits
# keybind = cmd+shift+h=goto_split:left
# keybind = cmd+shift+l=goto_split:right
# keybind = cmd+shift+j=goto_split:bottom
# keybind = cmd+shift+k=goto_split:top
keybind = alt+h=goto_split:left
keybind = alt+j=goto_split:down
keybind = alt+k=goto_split:up
keybind = alt+l=goto_split:right

keybind = cmd+i=inspector:toggle
keybind = cmd+r=reload_config

# Splits
# keybind = cmd+s=new_split:down
keybind = super+d=new_split:right
keybind = super+shift+d=new_split:down

# Resize splits
keybind = alt+shift+h=resize_split:left,20
keybind = alt+shift+j=resize_split:down,20
keybind = alt+shift+k=resize_split:up,20
keybind = alt+shift+l=resize_split:right,20

# Layout
keybind = alt+shift+e=equalize_splits
keybind = alt+super+x=close_surface

# Theme
# theme = tokyonight_moon
theme = dark:TokyoNight Moon,light:TokyoNight day
initial-window = true
shell-integration-features = no-cursor
font-family = "MonaspiceNe Nerd Font Mono"
font-style = Light
font-feature = -calt

# background-image = "/Users/sorokin/Downloads/bg_field.jpg"
# background-image-opacity = 0.1
# background-image-fit = cover
# background-blur-radius = 20

quick-terminal-animation-duration = 0.3
quick-terminal-autohide = true
quick-terminal-position = center

window-padding-x = 4
window-padding-y = 4
window-padding-balance = true
keybind = shift+enter=text:\x1b\r
