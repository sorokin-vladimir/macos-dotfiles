# KEYBINDS
keybind = global:cmd+g=toggle_quick_terminal
keybind = cmd+shift+h=goto_split:left
keybind = cmd+shift+l=goto_split:right
keybind = cmd+shift+j=goto_split:bottom
keybind = cmd+shift+k=goto_split:top
keybind = cmd+s=new_split:down
keybind = cmd+i=inspector:toggle
keybind = cmd+r=reload_config

# Theme
# theme = tokyonight_moon
theme = dark:TokyoNight Moon,light:TokyoNight day
initial-window = true
shell-integration-features = no-cursor
font-family = "MonaspiceNe Nerd Font Mono"
font-style = Light
font-feature = -calt

# background-image = "/Users/sorokin/Downloads/bg_field.jpg"
# background-image-opacity = 0.1
# background-image-fit = cover
# background-blur-radius = 20

quick-terminal-animation-duration = 0.3
quick-terminal-autohide = true
quick-terminal-position = center

window-padding-x = 4
window-padding-y = 4
window-padding-balance = true
keybind = shift+enter=text:\x1b\r
