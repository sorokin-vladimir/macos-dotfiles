# KEYBINDS
keybind = global:cmd+g=toggle_quick_terminal

# Navigate between splits
# keybind = cmd+shift+h=goto_split:left
# keybind = cmd+shift+l=goto_split:right
# keybind = cmd+shift+j=goto_split:bottom
# keybind = cmd+shift+k=goto_split:top
# Split bindings use physical key codes (key_*) so they also work with the Russian layout
keybind = alt+key_h=goto_split:left
keybind = alt+key_j=goto_split:down
keybind = alt+key_k=goto_split:up
keybind = alt+key_l=goto_split:right

keybind = cmd+i=inspector:toggle
keybind = cmd+r=reload_config

# Splits
# keybind = cmd+s=new_split:down
keybind = super+key_d=new_split:right
keybind = super+shift+key_d=new_split:down

# Resize splits
keybind = alt+shift+key_h=resize_split:left,20
keybind = alt+shift+key_j=resize_split:down,20
keybind = alt+shift+key_k=resize_split:up,20
keybind = alt+shift+key_l=resize_split:right,20

# Layout
keybind = alt+shift+key_e=equalize_splits
keybind = alt+super+key_x=close_surface

# Theme
# theme = tokyonight_moon
theme = dark:TokyoNight Moon,light:TokyoNight day
initial-window = true
shell-integration-features = no-cursor,ssh-terminfo,ssh-env
font-family = "MonaspiceNe Nerd Font Mono"
font-style = Light
font-feature = -calt

# background-image = "/Users/sorokin/Downloads/bg_field.jpg"
# background-image-opacity = 0.1
# background-image-fit = cover
# background-blur-radius = 20

quick-terminal-animation-duration = 0.3
quick-terminal-autohide = true
quick-terminal-position = center

window-padding-x = 4
window-padding-y = 4
window-padding-balance = true
window-save-state = always
unfocused-split-opacity = 0.6

notify-on-command-finish = unfocused
notify-on-command-finish-after = 5s

keybind = shift+enter=text:\x1b\r
